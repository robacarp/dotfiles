[color]
  diff = auto
  status = auto
  branch = auto
[push]
  default = simple
  autoSetupRemote = true
[core]
  autocrlf = input
[merge]
  tool = opendiff
[pull]
  ff = only
[init]
  defaultBranch = master
[user]
  name = robacarp
  useConfigOnly = true
[include]
  path = ~/.config/git/conf.d/local.conf
